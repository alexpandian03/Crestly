# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=

# JWT Authentication (minimum 32 characters)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Initial Superadmin Seed (password: 12-72 characters, letter and number)
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional Demo Seed (development only)
DEMO_CLIENT_NAME=
DEMO_CLIENT_ADMIN_NAME=
DEMO_CLIENT_ADMIN_EMAIL=
DEMO_CLIENT_ADMIN_PASSWORD=
DEMO_USER_NAME=
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# File Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Provider (LLM_PROVIDER: chain | groq | cerebras | mistral | openrouter | gemini | openai | mock)
LLM_PROVIDER=chain
LLM_CHAIN=groq,cerebras,gemini,mock

# Groq (OpenAI-compatible: https://api.groq.com/openai/v1)
GROQ_API_KEY=
GROQ_MODEL=

# Cerebras (OpenAI-compatible: https://api.cerebras.ai/v1)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=

# Mistral (OpenAI-compatible: https://api.mistral.ai/v1)
MISTRAL_API_KEY=
MISTRAL_MODEL=

# OpenRouter (OpenAI-compatible: https://openrouter.ai/api/v1)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Standalone providers
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=

# Image Search Provider (IMAGE_SEARCH_PROVIDER: unsplash | pexels | mock)
IMAGE_SEARCH_PROVIDER=
UNSPLASH_APP_NAME=
UNSPLASH_API_KEY=
UNSPLASH_API_SECRET=
PEXELS_API_KEY=

# Picture making (POST /api/posters/image)
# mock returns one stock placeholder and needs no key. gemini uses the GEMINI_API_KEY above.
# openai is deliberately not offered: its pictures need 30-45 s, longer than this app's function
# may run, so it is reported rather than wired up. See vercel.json maxDuration (60 s).
IMAGE_PROVIDER=mock
# Optional: which Gemini picture model to ask. Defaults to gemini-2.5-flash-image.
GEMINI_IMAGE_MODEL=

# Sentry Error Monitoring (optional)
SENTRY_DSN=
VITE_SENTRY_DSN=
