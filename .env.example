# Universal AI Model & Key Config (applies to every AI call in the codebase)
# Set AI_PROVIDER (auto, cloudflare, huggingface, gemini, openai, mock), AI_MODEL, and AI_API_KEY.
# When AI_PROVIDER is omitted or "auto", provider is inferred from AI_MODEL automatically.
AI_PROVIDER=auto
AI_MODEL=@cf/black-forest-labs/flux-2-klein-9b
AI_API_KEY=
AI_ACCOUNT_ID=
AI_BASE_URL=
AI_FALLBACK_MODELS=

# Stock Photo Search & Email (Optional)
IMAGE_SEARCH_PROVIDER=
UNSPLASH_APP_NAME=
UNSPLASH_API_KEY=
UNSPLASH_API_SECRET=
PEXELS_API_KEY=

RESEND_API_KEY=
MAIL_FROM=
