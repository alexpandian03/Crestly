{
  "name": "ai-poster-generator",
  "version": "1.0.0",
  "description": "Multi-client SaaS AI Poster Generator deployable on Vercel",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "node --watch server/dev.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n \"API,VITE\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm --prefix client install && npm --prefix client run build",
    "build": "npm run build:client",
    "install:all": "npm install && npm --prefix client install",
    "seed": "node server/scripts/seed.js",
    "seed:demo": "node server/scripts/seed-demo.js",
    "migrate:templates": "node server/scripts/migrate-templates.js",
    "migrate:brandkit": "node server/scripts/migrate-brandkit.js",
    "migrate:poster-designs": "node server/scripts/migrate-poster-designs.js",
    "test:auth": "vitest run tests/server/security.test.js",
    "test:stage8": "vitest run tests/server/localRolesSetup.test.js",
    "test:stage9": "vitest run tests/server/templateDocSize.test.js",
    "test:brandkit": "vitest run tests/server/brandKitBands.test.js",
    "test:posterdesign": "vitest run tests/server/localRolesSetup.test.js",
    "test:elements": "vitest run tests/server/templateSlotFields.test.js",
    "test:acceptance:e2e": "playwright test e2e/acceptance.spec.js",
    "start": "node server/dev.js",
    "test": "vitest run",
    "test:server": "vitest run",
    "test:client": "npm --prefix client run test",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@sentry/node": "11.6.0",
    "ajv": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.3.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "multer": "^2.4.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "resend": "^6.34.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "concurrently": "^9.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "vitest": "4.1.11"
  }
}
