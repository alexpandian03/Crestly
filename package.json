{
  "name": "ai-poster-generator",
  "version": "1.0.0",
  "description": "Multi-client SaaS AI Poster Generator deployable on Vercel",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "node --watch server/dev.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n \"API,VITE\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm --prefix client install && npm --prefix client run build",
    "build": "npm run build:client",
    "install:all": "npm install && npm --prefix client install",
    "seed": "node server/scripts/seed.js",
    "seed:demo": "node server/scripts/seed-demo.js",
    "migrate:templates": "node server/scripts/migrate-templates.js",
    "migrate:brandkit": "node server/scripts/migrate-brandkit.js",
    "migrate:poster-designs": "node server/scripts/migrate-poster-designs.js",
    "test:auth": "node server/scripts/test-auth.js",
    "test:stage8": "node server/scripts/test-stage8.js",
    "test:stage9": "node server/scripts/test-stage9.js",
    "test:brandkit": "node server/scripts/test-brandkit.js",
    "test:posterdesign": "node server/scripts/test-poster-design.js",
    "test:elements": "node server/scripts/test-template-elements.js",
    "test:recipes": "node server/scripts/test-design-recipes.js",
    "test:timeago": "node server/scripts/test-time-ago.js",
    "test:aidesign": "node server/scripts/test-poster-ai-design.js",
    "test:image": "node server/scripts/test-poster-image.js",
    "test:e2e-generate": "node server/scripts/test-e2e-generate.js",
    "start": "node server/dev.js"
  },
  "dependencies": {
    "@sentry/node": "11.6.0",
    "ajv": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "multer": "^2.4.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "concurrently": "^9.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "vitest": "4.1.11"
  }
}
