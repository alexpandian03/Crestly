# Server Environment Variables (Render Backend)
NODE_ENV=production
PORT=5000

# Database (Render standard variable is DATABASE_URL, MONGODB_URI is also supported)
DATABASE_URL=mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/posterai?retryWrites=true&w=majority
# MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/posterai?retryWrites=true&w=majority

# Authentication Secret (At least 32 characters long)
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# Frontend URL (Required for CORS fallback and invite/reset links)
CLIENT_URL=https://my-poster-app.vercel.app

# Media Storage (Cloudinary - optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI & Image Providers (Optional)
LLM_PROVIDER=chain
GROQ_API_KEY=
GEMINI_API_KEY=
UNSPLASH_API_KEY=
RESEND_API_KEY=
